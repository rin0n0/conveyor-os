// Standard Project Conveyor Layout for Zellij 0.46+ (inside Foot)
layout {
    default_tab_template {
        pane size=1 borderless=true {
            plugin location="zellij:tab-bar"
        }
        children
        pane size=2 borderless=true {
            plugin location="zellij:status-bar"
        }
    }

    tab name="1:agents" focus=true {
        pane split_direction="vertical" {
            pane size="55%" name="agy-or-opencode"
            pane split_direction="horizontal" size="45%" {
                pane name="local-moe-queue" command="pueue" {
                    args "status"
                }
                pane name="llmtop-vram"
            }
        }
    }

    tab name="2:review-git" {
        pane split_direction="vertical" {
            pane size="60%" name="neovim-diffview" command="nvim" {
                args "-c" "DiffviewOpen"
            }
            pane size="40%" name="lazygit" command="lazygit"
        }
    }

    tab name="3:gates-logs" {
        pane name="quality-gates"
    }
}
