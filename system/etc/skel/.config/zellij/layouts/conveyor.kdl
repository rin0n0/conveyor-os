// Standard Project Conveyor Layout for Zellij 0.46+ (inside Foot)
layout {
    default_tab_template {
        pane size=1 borderless=true {
            plugin location="zellij:tab-bar"
        }
        children
        pane size=2 borderless=true {
            plugin location="zellij:status-bar"
        }
    }

    tab name="1:code" focus=true {
        pane split_direction="vertical" {
            pane size="60%" name="editor-or-agent"
            pane size="40%" name="terminal"
        }
    }

    tab name="2:git" {
        pane split_direction="vertical" {
            pane size="55%" name="git-shell"
            pane size="45%" name="lazygit" command="lazygit"
        }
    }

    tab name="3:files" {
        pane name="yazi" command="yazi"
    }
}
