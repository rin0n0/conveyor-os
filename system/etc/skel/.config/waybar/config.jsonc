{
    "layer": "top",
    "position": "top",
    "height": 32,
    "spacing": 6,
    "modules-left": [
        "niri/workspaces",
        "sway/workspaces",
        "custom/panel",
        "custom/files",
        "custom/project"
    ],
    "modules-center": [
        "custom/agents",
        "custom/pueue"
    ],
    "modules-right": [
        "custom/vram",
        "memory",
        "cpu",
        "network",
        "bluetooth",
        "pulseaudio",
        "clock",
        "tray"
    ],
    "niri/workspaces": {
        "format": "{index}:{name}"
    },
    "sway/workspaces": {
        "disable-scroll": true,
        "all-outputs": true,
        "format": "{name}"
    },
    "custom/panel": {
        "format": "⚙ Панель",
        "tooltip-format": "Открыть панель оператора (Super+F2)",
        "on-click": "/usr/local/bin/conveyor-panel-open.sh"
    },
    "custom/files": {
        "format": "📂 Файлы",
        "tooltip-format": "Открыть файловый менеджер Thunar (Super+E)",
        "on-click": "thunar"
    },
    "custom/project": {
        "format": "📁 {}",
        "exec": "cat \"$XDG_RUNTIME_DIR/conveyor-current-project\" 2>/dev/null || echo 'Проекты'",
        "interval": 3,
        "tooltip-format": "Переключатель проектов (Super+P)",
        "on-click": "/usr/local/bin/project-switcher.sh"
    },
    "custom/agents": {
        "format": "{}",
        "exec": "/usr/local/bin/waybar-agents.sh",
        "return-type": "json",
        "interval": 2,
        "tooltip": true
    },
    "custom/pueue": {
        "format": "{}",
        "exec": "/usr/local/bin/waybar-pueue.sh",
        "return-type": "json",
        "interval": 3,
        "tooltip": true
    },
    "custom/vram": {
        "format": "{}",
        "exec": "/usr/local/bin/waybar-vram.sh",
        "return-type": "json",
        "interval": 2,
        "tooltip": true
    },
    "cpu": {
        "format": " {usage}%",
        "interval": 2
    },
    "memory": {
        "format": " {used:0.1f}G/{total:0.1f}G",
        "interval": 2
    },
    "network": {
        "format-wifi": "󰖩 {essid}",
        "format-ethernet": "󰈀 {ipaddr}",
        "format-disconnected": "󰖪 Нет сети",
        "tooltip-format": "{ifname}: {ipaddr}/{cidr} (ЛКМ: профили, ПКМ: настройки)",
        "on-click": "/usr/local/bin/net-switch.sh",
        "on-click-right": "nm-connection-editor"
    },
    "bluetooth": {
        "format": "BT {status}",
        "format-disabled": "BT off",
        "format-off": "BT off",
        "format-connected": "BT {device_alias}",
        "tooltip-format": "{controller_alias}: {status}",
        "on-click": "blueman-manager"
    },
    "pulseaudio": {
        "format": "{icon} {volume}%",
        "format-muted": "🔇 muted",
        "format-icons": {
            "default": ["🔈", "🔉", "🔊"]
        }
    },
    "clock": {
        "format": " {:%H:%M}",
        "tooltip-format": "{:%Y-%m-%d | Week %V}"
    },
    "tray": {
        "spacing": 8
    }
}
