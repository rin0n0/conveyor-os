[Unit]
Description=Conveyor GPU, CPU and RAM hardware probe
After=systemd-udev-trigger.service systemd-modules-load.service local-fs.target
Before=greetd.service display-manager.service llama-swap.service

[Service]
Type=oneshot
ExecStart=/usr/local/libexec/boot-gpu-detect.sh
RemainAfterExit=yes
TimeoutStartSec=60

[Install]
WantedBy=multi-user.target
